# Optional: leave unset to use local DuckDB at data/earthquakes.duckdb
# Get a free token at https://motherduck.com (attach as GitHub Actions secret MOTHERDUCK_TOKEN)
MOTHERDUCK_TOKEN=

# MotherDuck / local database name
DUCKDB_DATABASE=earthquakes

# Seed window (ISO dates). Keep modest for class; enlarge later if you want.
SEED_START=2025-01-01
SEED_END=2026-11-12
SEED_MIN_MAGNITUDE=2.5